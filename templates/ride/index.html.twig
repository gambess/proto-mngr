{% extends 'base.html.twig' %}

{% block title %}Ride index{% endblock %}

{% block body %}
    <h1>Ride index</h1>

    <table class="table">
        <thead>
            <tr>
                <th>Id</th>
                <th>Name</th>
                <th>actions</th>
            </tr>
        </thead>
        <tbody>
        {% for ride in rides %}
            <tr>
                <td>{{ ride.id }}</td>
                <td>{{ ride.name }}</td>
                <td>
                    <a href="{{ path('app_ride_show', {'id': ride.id}) }}">show</a>
                    <a href="{{ path('app_ride_edit', {'id': ride.id}) }}">edit</a>
                </td>
            </tr>
        {% else %}
            <tr>
                <td colspan="3">no records found</td>
            </tr>
        {% endfor %}
        </tbody>
    </table>

    <a href="{{ path('app_ride_new') }}">Create new</a>
{% endblock %}
