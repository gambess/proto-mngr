{% extends 'base.html.twig' %}

{% block title %}RideStop{% endblock %}

{% block body %}
    <h1>RideStop</h1>

    <table class="table">
        <tbody>
            <tr>
                <th>Id</th>
                <td>{{ ride_stop.id }}</td>
            </tr>
            <tr>
                <th>Arrival_time</th>
                <td>{{ ride_stop.arrivalTime ? ride_stop.arrivalTime|date('Y-m-d H:i:s') : '' }}</td>
            </tr>
            <tr>
                <th>Num_passengers</th>
                <td>{{ ride_stop.numPassengers }}</td>
            </tr>
        </tbody>
    </table>

    <a href="{{ path('app_ride_stop_index') }}">back to list</a>

    <a href="{{ path('app_ride_stop_edit', {'id': ride_stop.id}) }}">edit</a>

    {{ include('ride_stop/_delete_form.html.twig') }}
{% endblock %}
