{% extends 'base.html.twig' %}

{% block title %}Stop index{% endblock %}

{% block body %}
    <h1>Stop index</h1>

    <table class="table">
        <thead>
            <tr>
                <th>Id</th>
                <th>Name</th>
                <th>actions</th>
            </tr>
        </thead>
        <tbody>
        {% for stop in stops %}
            <tr>
                <td>{{ stop.id }}</td>
                <td>{{ stop.name }}</td>
                <td>
                    <a href="{{ path('app_stop_show', {'id': stop.id}) }}">show</a>
                    <a href="{{ path('app_stop_edit', {'id': stop.id}) }}">edit</a>
                </td>
            </tr>
        {% else %}
            <tr>
                <td colspan="3">no records found</td>
            </tr>
        {% endfor %}
        </tbody>
    </table>

    <a href="{{ path('app_stop_new') }}">Create new</a>
{% endblock %}
